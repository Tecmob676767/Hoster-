# Server
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hosterplus

# Session
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT for AI tokens
JWT_SECRET=change_this_to_a_long_random_jwt_secret

# File Storage
UPLOADS_DIR=./uploads

# Nginx (for production)
NGINX_SITES_DIR=/etc/nginx/sites-enabled
NGINX_RELOAD_CMD=sudo nginx -s reload
